.git
.gitignore

# Host build output must never become input to the container build.
config.cache
config.log
config.status
src/*.o
src/.accepted
bin/*
!bin/README
lib/world/wld/map
lib/world/wld/read_map
*.dSYM

# Runtime state belongs in named volumes, even when building a used checkout.
data/*
!data/README
log/*
!log/README
lib/misc/game_data
lib/equipment.csv
lib/books/libraries
lib/etc/*
!lib/etc/README
!lib/etc/badsites
lib/boards/**
!lib/boards/**/README
lib/channels/**
!lib/channels/**/README
lib/empires/**
!lib/empires/**/README
lib/packs/**
!lib/packs/**/README
lib/players/**
!lib/players/**/README
lib/plralias/**
!lib/plralias/**/README
lib/plrlore/**
!lib/plrlore/**/README
lib/plrobjs/**
!lib/plrobjs/**/README
lib/plrvars/**
!lib/plrvars/**/README
lib/world/binary_map
lib/world/binary_world_index
lib/world/wld/**
!lib/world/wld/**/README
syslog
syslog.*

# Local editor and OS files.
*~
.DS_Store
